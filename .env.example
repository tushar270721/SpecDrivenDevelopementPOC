# ==========================================
# Azure DevOps Configuration
# ==========================================
# Organization URL (from your Azure DevOps account)
AZDO_ORG_URL=https://dev.azure.com/enablon

# Project name (must match exactly)
AZDO_PROJECT_NAME=ART - New SaaS

# Personal Access Token (PAT)
# 1. Go to: https://dev.azure.com/enablon/_usersSettings/tokens
# 2. Create new token with "Work Items" (Read & Write) scope
# 3. Copy the token and paste below (shown only once!)
AZDO_PAT=<your-personal-access-token-here>

# ==========================================
# MCP Configuration (Optional)
# ==========================================
MCP_ENABLED=true
MCP_AZURE_DEVOPS_ENABLED=true

# ==========================================
# Test Configuration
# ==========================================
TARGET_ENVIRONMENT=local
TEST_ENVIRONMENT=local
